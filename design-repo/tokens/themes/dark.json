{
  "$description": "Theme instance for the .ctx-dark section context. Resolves every semantic colour to a foundation token.",
  "theme": "dark",
  "selector": ".ctx-dark",
  "colorScheme": "dark",
  "resolves": {
    "fg": "{color.white}",
    "fg-sub": "{color.alpha.white-80}",
    "fg-soft": "{color.alpha.white-65}",
    "line-sub": "{color.alpha.paper-20}",
    "line-soft": "{color.alpha.paper-8}",
    "hover-tint": "{color.alpha.white-10}",
    "action": "{color.purple.20}",
    "action-hover": "{color.purple.30}",
    "action-active": "{color.purple.40}",
    "action-secondary": "{color.alpha.white-90}",
    "action-secondary-hover": "{color.white}",
    "on-action": "{color.neutral.90}",
    "highlight": "{color.sky.40}"
  },
  "$extensions": {
    "measuredFrom": [
      {
        "path": "src/index.css",
        "lines": "72-89",
        "expect": "/* Semantic colours: dark context */"
      }
    ]
  }
}
