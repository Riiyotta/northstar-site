{
  "$description": "Type families, weights and roles. Copied from tailwind.config.js fontFamily/fontWeight/fontSize. Letter-spacing compensation (--ls-comp: -0.0035em) offsets Hanken Grotesk's +0.8% width vs the original face (CLONE_SPEC.md 0.5).",
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Hanken Grotesk",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Roboto",
        "Oxygen",
        "Ubuntu",
        "Cantarell",
        "Fira Sans",
        "Droid Sans",
        "Helvetica Neue",
        "sans-serif"
      ],
      "$description": "OFL substitute for the original's proprietary sans."
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "Times",
        "serif"
      ],
      "$description": "OFL substitute for the original's proprietary serif (/plans quotes only)."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "$description": "OFL substitute for the original's proprietary mono (/go eyebrows)."
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 460
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 540
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "letterSpacingCompensation": {
    "$type": "dimension",
    "$value": "-0.0035em",
    "$description": "--ls-comp; added to every sans role."
  },
  "fontSize": {
    "display-sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(36px, 16px + 3.125vw, 61px)",
        "lineHeight": "1.1",
        "letterSpacing": "calc(-0.0275em + var(--ls-comp))",
        "fontWeight": 460
      },
      "$description": "Page h1 (product heroes, split heroes, plans title)."
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(32px, 18.4px + 2.125vw, 49px)",
        "lineHeight": "1.2",
        "letterSpacing": "calc(-0.0275em + var(--ls-comp))",
        "fontWeight": 460
      },
      "$description": "Section h2."
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(28px, 19.2px + 1.375vw, 39px)",
        "lineHeight": "1.2",
        "letterSpacing": "calc(-0.0275em + var(--ls-comp))",
        "fontWeight": 460
      },
      "$description": "Feature-row h2, quote h2, CTA band h2 (md)."
    },
    "heading-sm": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(24px, 18.4px + 0.875vw, 31px)",
        "lineHeight": "1.2",
        "letterSpacing": "calc(-0.0275em + var(--ls-comp))",
        "fontWeight": 460
      },
      "$description": "Grid item titles, feature subheads."
    },
    "heading-xs": {
      "$type": "typography",
